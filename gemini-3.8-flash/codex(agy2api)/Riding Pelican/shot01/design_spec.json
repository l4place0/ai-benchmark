      "description": "Navy blue cycling cap with flipped visor, crimson silk scarf knot and dual fluttering polka-dot streamers."
    },
    {
      "index": 13,
      "id": "layer_13_bicycle_main_frame_and_chainring",
      "description": "Seat tube, curved twin top cruiser tubes, down tube, head tube, bottom bracket shell, 5-star chrome chainring, painted chainguard cover with speed striping."
    },
    {
      "index": 14,
      "id": "layer_14_front_fork_and_wheel",
      "description": "Front fork steerer and curved blades, front mint-teal fender with chrome stay, front tire, whitewall ring, chrome rim, 24 spokes, front axle hub."
    },
    {
      "index": 15,
      "id": "layer_15_steering_controls_and_bell",
      "description": "Quill stem, chrome sweeping cruiser handlebar, stitched leather right grip, vintage brass bell with ding soundwave accents, brake levers and curving cables."
    },
    {
      "index": 16,
      "id": "layer_16_foreground_leg_and_crank",
      "description": "Pelican right downy thigh pantaloons, muscular orange tarsus with scale textures, expansive webbed foot bearing down on lower pedal, right chrome crank arm."
    },
    {
      "index": 17,
      "id": "layer_17_foreground_wing",
      "description": "Pelican right wing covert feathers, gracefully arched primary flight feathers gripping the bar, index primary feather poised playfully at the bell ringer."
    },
    {
      "index": 18,
      "id": "layer_18_foreground_lighting_and_atmosphere",
      "description": "Subtle foreground coastal sun glints, speed wind streaks, tiny dust puff at tire contact, overall master vignette."
